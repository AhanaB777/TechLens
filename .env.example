# Set DATABASE_URL to your Neon PostgreSQL connection URL. Keep credentials out of source control.
# Copy this file to .env for local app configuration; .env.local is also loaded by Django and Compose.
DATABASE_URL=
DEBUG=True
SECRET_KEY=local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Gmail SMTP requires a Google App Password, not your regular account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# For production, set DEBUG=False, use a strong SECRET_KEY, and configure
# ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS for your deployed domains.
