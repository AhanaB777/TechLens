# Copy to .env for local app configuration; Neon link writes DATABASE_URL to .env.local.
DEBUG=True
SECRET_KEY=local-development-only
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# For production, set DEBUG=False, use a strong SECRET_KEY, and configure
# ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS for your deployed domains.
